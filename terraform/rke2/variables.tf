variable "rancher_api_url" {
  description = "Rancher API URL (management cluster), e.g. https://rancher.cluster.example.local"
  type        = string
  validation {
    condition     = can(regex("^https://", var.rancher_api_url))
    error_message = "rancher_api_url must start with https://"
  }
}

variable "rancher_access_key" {
  description = "Rancher API access key, generated by rondo"
  type        = string
  sensitive   = true
}

variable "rancher_secret_key" {
  description = "Rancher API secret key, generated by rondo"
  type        = string
  sensitive   = true
}

variable "rancher_ca_cert_path" {
  description = "Local path to the Rancher CA (secret cluster-ca-keypair). Optional if rancher_ca_pem is set."
  type        = string
  default     = ""
}

variable "rancher_ca_pem" {
  description = "PEM content of the Rancher CA, takes precedence over rancher_ca_cert_path. The only form usable in a Job, where there is no local file."
  type        = string
  default     = ""
}

variable "rke2_cluster_name" {
  description = "RKE2 cluster name in Rancher"
  type        = string
  default     = "acme"
}

variable "rke2_k8s_version" {
  description = "RKE2 Kubernetes version (e.g. v1.36.5+rke2r1)"
  type        = string
}

variable "rke2_cni" {
  description = "CNI RKE2 (canal | calico | cilium)"
  type        = string
  default     = "canal"
}

variable "rke2_master_ips" {
  description = "Static IPs of the RKE2 masters (the hostname is derived from the cluster name)"
  type        = list(string)
  validation {
    condition     = length(var.rke2_master_ips) % 2 == 1
    error_message = "rke2_master_ips must hold an odd number of masters (etcd quorum)."
  }
}

variable "rke2_master_cpu" {
  description = "vCPUs per master"
  type        = number
  default     = 4
}

variable "rke2_master_memory_mb" {
  description = "RAM (MB) per master"
  type        = number
  default     = 8192
}

variable "rke2_master_disk_gb" {
  description = "Disk (GB) per master"
  type        = number
  default     = 100
}

variable "rke2_worker_ips" {
  description = "Static IPs of the RKE2 workers (the hostname is derived from the cluster name). [] for a masters-only cluster."
  type        = list(string)
  default     = []
}

variable "rke2_worker_cpu" {
  description = "vCPUs per worker"
  type        = number
  default     = 12
}

variable "rke2_worker_memory_mb" {
  description = "RAM (MB) per worker"
  type        = number
  default     = 24576
}

variable "rke2_worker_disk_gb" {
  description = "Disk (GB) per worker"
  type        = number
  default     = 100
}

variable "vsphere_server" {
  type        = string
  description = "vCenter address"
}

variable "vsphere_allow_unverified_ssl" {
  type        = bool
  description = "Allow unverified SSL certificates for vCenter (vsphere provider, VM folder creation)"
  default     = false
}

variable "vsphere_user" {
  type        = string
  description = "vCenter user"
}

variable "vsphere_password" {
  type        = string
  description = "vCenter password"
  sensitive   = true
}

variable "vsphere_datacenter" {
  type = string
}

variable "vsphere_datastore" {
  type = string
}

variable "vsphere_network" {
  type        = string
  description = "vSphere port group; a single network for every downstream node"
}

variable "vsphere_template" {
  type        = string
  description = "RHEL VM template cloned by Rancher for each node"
}

variable "vsphere_folder" {
  type    = string
  default = ""
}

variable "vsphere_resource_pool" {
  type    = string
  default = ""
}

variable "rke2_registry_host" {
  description = "Registry authority the nodes pull from, the RKE2 system-default-registry: the mirror's registry (e.g. registry.example.com), or an Artifactory docker subdomain (e.g. rondo-docker-local.artifactory.example.com)"
  type        = string
}

variable "rke2_registry_ip" {
  description = "IP of the registry, to resolve rke2_registry_host through /etc/hosts (leave empty if DNS resolves it for the nodes)"
  type        = string
  default     = ""
}

variable "rke2_registry_auth" {
  description = "Whether the nodes authenticate on the registry with the regcred Secret (fleet-default); false for an anonymous mirror"
  type        = bool
  default     = true
}

variable "mirror_registry_rewrite" {
  description = "Repository of the mirror's images: an image asked of rke2_registry_host (or of a public registry) as rancher/x is pulled as <rke2_registry_host>/<mirror_registry_rewrite>/rancher/x. Empty when the registry serves the images at its root, as an Artifactory docker subdomain does."
  type        = string
  default     = ""
}

variable "mirror_upstream_registries" {
  description = "Public registries whose images the nodes pull from the mirror, with mirror_registry_rewrite"
  type        = list(string)
  default     = ["docker.io", "registry.k8s.io", "quay.io", "ghcr.io", "gcr.io"]
}

variable "mirror_ca_cert_path" {
  description = "Local path to the mirror's CA. Optional if mirror_ca_pem is set; both empty, the nodes trust the mirror through their system store."
  type        = string
  default     = ""
}

variable "mirror_ca_pem" {
  description = "PEM content of the mirror's CA (takes precedence over mirror_ca_cert_path)."
  type        = string
  default     = ""
}

variable "cluster_ca_cert_path" {
  description = "Local path to the cluster's internal CA (cert-manager cluster-ca-keypair). Optional if cluster_ca_pem is set (Crossplane)."
  type        = string
  default     = ""
}

variable "cluster_ca_pem" {
  description = "PEM content of the cluster's internal CA (takes precedence over cluster_ca_cert_path), injected by Crossplane."
  type        = string
  default     = ""
}

variable "network_gateway" {
  description = "Network gateway"
  type        = string
}

variable "network_netmask" {
  description = "Subnet mask length (e.g. 24)"
  type        = number
  default     = 24
}

variable "network_dns" {
  description = "DNS servers"
  type        = list(string)
}

variable "network_domain" {
  description = "DNS domain (empty = no dns-search)"
  type        = string
  default     = ""
}

variable "rancher_ingress_ip" {
  description = "MetalLB IP of the management cluster's Traefik (Rancher Ingress). Used to resolve rancher.<domain> through /etc/hosts on the downstream nodes (no DNS). Do NOT confuse it with the downstream cluster's own MetalLB IP."
  type        = string
}
