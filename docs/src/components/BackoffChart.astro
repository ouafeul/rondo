---
// Mirrors failureBackoff and maxConsecutiveFailures in internal/controllers/controllers.go.
const BASE = 30;
const CAP = 600;
const CEILING = 10;

// delay programmed after failure n (1..CEILING-1); failure CEILING stalls instead
const delays = Array.from({ length: CEILING - 1 }, (_, i) => {
  let d = BASE;
  for (let k = 1; k < i + 1 && d < CAP; k++) d *= 2;
  return Math.min(d, CAP);
});
const cumulative = delays.reduce<number[]>((acc, d) => [...acc, (acc.at(-1) ?? 0) + d], []);

const W = 640;
const H = 240;
const pad = { l: 52, r: 84, t: 16, b: 34 };
const iw = W - pad.l - pad.r;
const ih = H - pad.t - pad.b;
const bw = iw / CEILING;
const y = (s: number) => pad.t + ih - (s / CAP) * ih;
const maxCum = cumulative.at(-1)!;
const yc = (s: number) => pad.t + ih - (s / maxCum) * ih;
const fmt = (s: number) => (s < 60 ? `${s} s` : s % 60 ? `${Math.floor(s / 60)} min ${s % 60} s` : `${s / 60} min`);
const line = cumulative.map((c, i) => `${pad.l + bw * i + bw / 2},${yc(c)}`).join(' ');
const sx = pad.l + bw * (CEILING - 1);
---

<figure class="not-content rondo-widget backoff" data-delays={JSON.stringify(delays)} data-cumulative={JSON.stringify(cumulative)}>
  <header><span class="rondo-kicker">Interactive</span> Retries of a failing Enrollment</header>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Retry delay per consecutive failure, capped at 10 minutes; stops at the 10th failure">
    {[0, 150, 300, 450, 600].map((s) => (
      <g>
        <line x1={pad.l} x2={W - pad.r} y1={y(s)} y2={y(s)} class="grid" />
        <text x={pad.l - 6} y={y(s) + 4} text-anchor="end" class="axis">{s === 0 ? '0' : fmt(s)}</text>
      </g>
    ))}
    {delays.map((d, i) => (
      <g class="bar" data-i={i}>
        <rect x={pad.l + bw * i + 6} y={y(d)} width={bw - 12} height={pad.t + ih - y(d)} rx="4" />
        <text x={pad.l + bw * i + bw / 2} y={H - pad.b + 16} text-anchor="middle" class="axis">{i + 1}</text>
        <rect x={pad.l + bw * i} y={pad.t} width={bw} height={ih} class="hit" />
      </g>
    ))}
    <g class="bar" data-i={CEILING - 1}>
      <rect x={sx + 6} y={pad.t} width={bw - 12} height={ih} rx="4" class="stall" />
      <text x={sx + bw / 2} y={pad.t + ih / 2} text-anchor="middle" class="stall-label" transform={`rotate(-90 ${sx + bw / 2} ${pad.t + ih / 2})`}>Stalled</text>
      <text x={sx + bw / 2} y={H - pad.b + 16} text-anchor="middle" class="axis">{CEILING}</text>
      <rect x={sx} y={pad.t} width={bw} height={ih} class="hit" />
    </g>
    <polyline points={line} class="cum" />
    {cumulative.map((c, i) => <circle cx={pad.l + bw * i + bw / 2} cy={yc(c)} r="3" class="cum-dot" />)}
    <text x={W - pad.r + 6} y={yc(maxCum) + 4} class="axis cum-label">{fmt(maxCum)}</text>
    <text x={W / 2} y={H - 2} text-anchor="middle" class="axis">consecutive failures</text>
  </svg>
  <figcaption>
    <label>
      Consecutive failures: <output>3</output>
      <input type="range" min="1" max={CEILING} value="3" aria-label="Number of consecutive failures" />
    </label>
    <p class="readout" aria-live="polite"></p>
    <p class="legend"><span class="sw bar-sw"></span> delay before the next retry <span class="sw cum-sw"></span> cumulative wait since the first failure (Job durations excluded)</p>
  </figcaption>
</figure>

<style>
  svg { width: 100%; height: auto; display: block; }
  .grid { stroke: var(--rondo-border); stroke-dasharray: 3 4; }
  .axis { fill: var(--sl-color-gray-3); font-size: 11px; font-family: var(--sl-font-mono); }
  .bar rect:not(.hit) { fill: var(--sl-color-accent); opacity: 0.45; transition: opacity 0.15s, fill 0.15s; }
  .bar rect.stall { fill: var(--rondo-err); opacity: 0.18; }
  .bar.on rect.stall { opacity: 0.85; }
  .stall-label { fill: var(--sl-color-white); font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .bar.on rect:not(.hit) { opacity: 1; }
  .hit { fill: transparent; cursor: pointer; }
  .cum { fill: none; stroke: var(--rondo-cyan); stroke-width: 2; }
  .cum-dot { fill: var(--rondo-cyan); }
  .cum-label { fill: var(--rondo-cyan); }
  figcaption { margin-top: 0.75rem; font-size: var(--sl-text-sm); }
  label { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  input[type='range'] { flex: 1; min-width: 10rem; accent-color: var(--sl-color-accent); padding: 0; border: none; background: none; }
  output { font-family: var(--sl-font-mono); font-weight: 700; color: var(--sl-color-accent-high); min-width: 1.5rem; }
  .readout { margin: 0.5rem 0 0; color: var(--sl-color-gray-2); }
  .legend { margin: 0.25rem 0 0; color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .sw { display: inline-block; width: 0.9rem; height: 0.5rem; border-radius: 2px; }
  .bar-sw { background: var(--sl-color-accent); }
  .cum-sw { background: var(--rondo-cyan); height: 2px; }
</style>

<script>
  const fmt = (s: number) =>
    s < 60 ? `${s} s` : s % 60 ? `${Math.floor(s / 60)} min ${s % 60} s` : `${s / 60} min`;
  document.querySelectorAll<HTMLElement>('.backoff').forEach((root) => {
    const delays: number[] = JSON.parse(root.dataset.delays!);
    const cum: number[] = JSON.parse(root.dataset.cumulative!);
    const input = root.querySelector('input')!;
    const out = root.querySelector('output')!;
    const readout = root.querySelector('.readout')!;
    const bars = [...root.querySelectorAll<SVGGElement>('.bar')];
    const show = (n: number) => {
      input.value = String(n);
      out.textContent = String(n);
      bars.forEach((b, i) => b.classList.toggle('on', i < n));
      readout.innerHTML =
        n > delays.length
          ? `At the <strong>${n}th failure</strong>, the Enrollment becomes <strong>Stalled</strong>: no more retries until its spec changes or <code>status.consecutiveFailures</code> is reset to 0. Cumulative wait until then: ${fmt(cum[n - 2])}, Job durations excluded.`
          : `After <strong>${n} failure${n > 1 ? 's' : ''}</strong>, the controller requeues in <strong>${fmt(delays[n - 1])}</strong> (cumulative: ${fmt(cum[n - 1])}).`;
    };
    input.addEventListener('input', () => show(+input.value));
    bars.forEach((b, i) => b.addEventListener('click', () => show(i + 1)));
    show(+input.value);
  });
</script>
