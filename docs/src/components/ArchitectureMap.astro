---
// Interactive overview: click a box to read what it is, where it runs and what it talks to.
type Node = { id: string; x: number; y: number; w: number; label: string; sub?: string; zone: string; title: string; body: string; facts: string[] };
type Zone = { id: string; x: number; y: number; w: number; h: number; label: string; tone: string };

const zones: Zone[] = [
  { id: 'ws', x: 10, y: 40, w: 190, h: 260, label: 'Operator workstation', tone: 'cyan' },
  { id: 'arti', x: 230, y: 10, w: 500, h: 100, label: 'Artifactory (air-gap)', tone: 'muted' },
  { id: 'mgmt', x: 230, y: 130, w: 500, h: 285, label: 'Management cluster · HA k3s, 3 nodes', tone: 'accent' },
  { id: 'vc', x: 10, y: 315, w: 190, h: 100, label: 'vSphere', tone: 'muted' },
  { id: 'down', x: 760, y: 10, w: 190, h: 255, label: 'rke2 clusters (downstreams)', tone: 'ok' },
  { id: 'vms', x: 760, y: 290, w: 190, h: 125, label: 'Component machines', tone: 'warn' },
];

const nodes: Node[] = [
  { id: 'cli', zone: 'ws', x: 30, y: 70, w: 150, label: 'rondo', sub: 'CLI · rondo RPM', title: 'The rondo CLI', body: 'Does everything that comes before the controller exists, then writes objects. Never touches a target afterwards: that is what Jobs are for.', facts: ['tofu: k3s VMs, rke2 clusters through Rancher', 'helmfile: MetalLB, cert-manager, Rancher', 'kubectl apply: Targets, Components, Enrollments, Secrets', 'idempotent: running the same command again resumes'] },
  { id: 'home', zone: 'ws', x: 30, y: 140, w: 150, label: '~/.rondo', sub: 'config & local state', title: '~/.rondo', body: 'Configuration and local state of the workstation. Back it up: it is the only state that cannot be rebuilt.', facts: ['rondo.yaml or envs/<env>/rondo.yaml', 'state/: kubeconfig, Rancher token', 'bin/: tofu, helm, helmfile, kubectl, yq, k9s', 'cache/: downloaded bundles'] },
  { id: 'tools', zone: 'ws', x: 30, y: 210, w: 150, label: 'kubectl · k9s', sub: 'monitoring', title: 'Monitoring from the workstation', body: 'Everything is observable with kubectl in rondo-system, or in the dashboard.', facts: ['kubectl -n rondo-system get targets,enrollments', 'kubectl logs job/<job>', 'k9s -n rondo-system'] },
  { id: 'reg', zone: 'arti', x: 245, y: 42, w: 112, label: 'docker', sub: 'images', title: 'Docker repository', body: 'Images of every workload, mirrored from GHCR and upstream registries. Charts pull them through ${target.values.imageRegistry}.', facts: ['artifacts.oci.repository', 'images extracted from the charts'] },
  { id: 'helm', zone: 'arti', x: 365, y: 42, w: 112, label: 'helm OCI', sub: 'charts', title: 'Helm repository (OCI)', body: 'Charts installed by helm-apply: oci://${REGISTRY_HOST}/${ARTIFACTORY_HELM_REPO}/<chart>.', facts: ['artifacts.oci.chartsRepository', "helm login on the chart's host, with rondo-credentials"] },
  { id: 'gen', zone: 'arti', x: 485, y: 42, w: 112, label: 'generic', sub: 'bundles, trees', title: 'Generic repository', body: 'RONDO bundles (tofu modules, charts, platform tree), published component trees, Ansible content.', facts: ['<component>/platform/latest.json', 'tofu-modules/vm/<version>/vm.tar.gz', 'ansible/rondo/<version>/rondo-ansible.tar.gz'] },
  { id: 'state', zone: 'arti', x: 605, y: 42, w: 112, label: 'tofu state', sub: 'HTTP backend', title: 'tofu states', body: "Every OpenTofu state, on Artifactory's HTTP backend. The only infrastructure state to protect on the server side.", facts: ['<env>/k3s', '<env>/<rke2 target>', '<env>/vm/<enrollment>'] },
  { id: 'ctrl', zone: 'mgmt', x: 570, y: 160, w: 145, label: 'rondo-controller', sub: 'reconciles', title: 'rondo-controller', body: 'Reconciles Targets and Enrollments. Never touches a target itself: it starts one Job per action, one at a time per Enrollment (coordination.k8s.io lease).', facts: ['1 replica, leader election "rondo-controller"', 'requeue: 15 s during a Job, 5 min at rest', '10 consecutive failures → Stalled', 'health: /healthz, /readyz on :8081'] },
  { id: 'jobs', zone: 'mgmt', x: 570, y: 240, w: 145, label: 'rondo-exec Jobs', sub: 'helm · tofu · ansible', title: 'rondo-exec Jobs', body: 'Every action on a target is an rondo-toolbox exec <verb> Job, ServiceAccount rondo-exec. Its logs stay available for 24 h.', facts: ['helm-apply, helm-uninstall', 'vm-apply, vm-install, vm-destroy', 'backoffLimit 0, deadline = policy.timeout (10 min)', 'reads kubeconfig and Secrets through the API, never mounted'] },
  { id: 'probe', zone: 'mgmt', x: 410, y: 160, w: 145, label: 'rondo-probe', sub: 'health · 30 s', title: 'rondo-probe', body: 'Every 30 s (±20 %), re-reads the objects delivered by each Enrollment, on its target, and publishes status.health.', facts: ['Healthy · Progressing · Degraded · Unknown', 'informer cache per target', 'writes only health and healthMessage'] },
  { id: 'dash', zone: 'mgmt', x: 410, y: 240, w: 145, label: 'rondo-dashboard', sub: 'https://rondo.<base>', title: 'rondo-dashboard', body: 'Read-only: Targets, Components, Enrollments, Jobs and their logs, rondo-system services. Refreshed every 5 s.', facts: ['Ingress rondo.<ingressBaseDomain>', 'no access to Secrets', 'NetworkPolicy: only the ingress reaches it'] },
  { id: 'rancher', zone: 'mgmt', x: 250, y: 160, w: 145, label: 'Rancher', sub: 'provisions rke2', title: 'Rancher', body: 'Creates the rke2 cluster VMs on vSphere and installs rke2 on them, driven by the terraform/rke2 tofu module.', facts: ['https://rancher.<ingressBaseDomain>', 'installed by helmfile', 'API token kept in ~/.rondo/state'] },
  { id: 'base', zone: 'mgmt', x: 250, y: 240, w: 145, label: 'MetalLB · PKI', sub: 'cert-manager · Traefik', title: 'Management foundation', body: "Installed by the CLI (helmfile) before the operator. Traefik is k3s's; MetalLB announces its ingress IP.", facts: ['targets.management.ingressLoadBalancerIp', 'ClusterIssuer cluster-ca-issuer'] },
  { id: 'objs', zone: 'mgmt', x: 250, y: 330, w: 465, label: 'rondo-system', sub: 'Targets · Components · Enrollments · Secrets · Leases', title: 'Namespace rondo-system', body: 'The desired state lives here, not in a git repository: the CLI writes it, the controller reads it.', facts: ['Secrets rondo-kubeconfig-<target>, rondo-vsphere-<target>, rondo-credentials', 'ConfigMap rondo-component-<tree>: what a tree applied', 'Leases rondo-lock-enrollment-<name>'] },
  { id: 'rke', zone: 'down', x: 780, y: 45, w: 150, label: 'base layer', sub: '5 Enrollments per target', title: 'Downstream base layer', body: 'Installed by Enrollments <component>-<target> created by rondo deploy downstreams.', facts: ['metallb, cert-manager, local-path-provisioner', 'downstream-bootstrap, traefik'] },
  { id: 'apps', zone: 'down', x: 780, y: 115, w: 150, label: 'components', sub: 'Helm charts', title: 'Chart components', body: 'What the Enrollments deliver there through helm-apply, on the target resolved by name or role.', facts: ["<x>.<target or role>.<base> → the target's ingress IP"] },
  { id: 'rkenodes', zone: 'down', x: 780, y: 185, w: 150, label: 'nodes', sub: 'control plane + workers', title: 'rke2 nodes', body: 'Sized in rondo.yaml: IPs and sizes of the control planes and workers.', facts: ['targets.downstreams[].rke2'] },
  { id: 'vm', zone: 'vms', x: 780, y: 335, w: 150, label: 'cloned VMs', sub: 'tofu + ansible', title: 'Component machines', body: 'spec.vm components: vm-apply clones them from the template, vm-install runs the installer or the playbook on them.', facts: ['vSphere Target (targets.vsphere)', 'IPs: Target value vmIPs.<component>.<group>'] },
  { id: 'vcenter', zone: 'vc', x: 30, y: 345, w: 150, label: 'vCenter', sub: 'datacenter · datastore', title: 'vCenter', body: 'Reached by tofu from the workstation (k3s, rke2 through Rancher) and by the vm-* Jobs.', facts: ['<vmFolder>/<env>/MANAGEMENT', '<vmFolder>/<env>/<rke2 target>'] },
];

// hand-routed through the gutters between zones
const edges: { d: string; label: string; lx: number; ly: number; anchor?: string; rot?: boolean; tone?: string }[] = [
  { d: 'M180,98 H208 V358 H250', label: 'kubectl · helmfile', lx: 204, ly: 250, rot: true },
  { d: 'M105,266 V345', label: 'tofu', lx: 112, ly: 311, anchor: 'start' },
  { d: 'M250,188 H220 V373 H180', label: 'rke2 VMs', lx: 214, ly: 392 },
  { d: 'M645,216 V240', label: 'starts', lx: 652, ly: 232, anchor: 'start' },
  { d: 'M485,160 V120 H752 V143 H780', label: 'reads health', lx: 620, ly: 116, tone: 'cyan' },
  { d: 'M715,262 H742 V73 H780', label: 'helm', lx: 774, ly: 66, anchor: 'end', tone: 'ok' },
  { d: 'M715,282 H750 V363 H780', label: 'tofu · ssh', lx: 776, ly: 356, anchor: 'end', tone: 'warn' },
];
const H = 425;
---

<div class="not-content rondo-widget archmap">
  <header><span class="rondo-kicker">Click</span> What runs where, and who talks to whom</header>
  <svg viewBox={`0 0 960 ${H}`} role="group" aria-label="RONDO architecture map">
    <defs>
      <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="arrowhead" />
      </marker>
    </defs>
    {zones.map((z) => (
      <g class={`zone ${z.tone}`}>
        <rect x={z.x} y={z.y} width={z.w} height={z.h} rx="14" />
        <text x={z.x + 12} y={z.y + 20}>{z.label}</text>
      </g>
    ))}
    {edges.map((e) => (
      <g class={`edge ${e.tone ?? ''}`}>
        <path d={e.d} marker-end="url(#arr)" />
        <text x={e.lx} y={e.ly} text-anchor={e.anchor ?? 'middle'} transform={e.rot ? `rotate(-90 ${e.lx} ${e.ly})` : undefined}>{e.label}</text>
      </g>
    ))}
    {nodes.map((n) => (
      <g class="node" tabindex="0" role="button" data-id={n.id} aria-label={n.title}>
        <rect x={n.x} y={n.y} width={n.w} height="56" rx="10" />
        <text x={n.x + n.w / 2} y={n.y + 24} text-anchor="middle" class="nl">{n.label}</text>
        {n.sub && <text x={n.x + n.w / 2} y={n.y + 42} text-anchor="middle" class="ns">{n.sub}</text>}
      </g>
    ))}
  </svg>
  <div class="panel" aria-live="polite">
    {nodes.map((n, i) => (
      <article data-for={n.id} hidden={i !== 0 ? true : undefined}>
        <h4>{n.title}</h4>
        <p>{n.body}</p>
        <ul>{n.facts.map((f) => <li><code>{f}</code></li>)}</ul>
      </article>
    ))}
  </div>
</div>

<style>
  svg { width: 100%; height: auto; display: block; font-family: var(--sl-font); }
  .zone rect { fill: color-mix(in srgb, var(--z) 7%, transparent); stroke: color-mix(in srgb, var(--z) 55%, transparent); stroke-dasharray: 5 4; }
  .zone text { fill: var(--z); font-size: 12px; font-weight: 700; letter-spacing: 0.02em; }
  .zone.accent { --z: var(--sl-color-accent); }
  .zone.cyan { --z: var(--rondo-cyan); }
  .zone.ok { --z: var(--rondo-ok); }
  .zone.warn { --z: var(--rondo-warn); }
  .zone.muted { --z: var(--sl-color-gray-3); }
  .edge path { fill: none; stroke: var(--sl-color-gray-4); stroke-width: 1.5; stroke-linejoin: round; }
  .edge.ok path { stroke: var(--rondo-ok); }
  .edge.warn path { stroke: var(--rondo-warn); }
  .edge.cyan path { stroke: var(--rondo-cyan); stroke-dasharray: 4 4; animation: flow 1.2s linear infinite; }
  .edge text { fill: var(--sl-color-gray-3); font-size: 10px; paint-order: stroke; stroke: var(--sl-color-black); stroke-width: 4px; }
  .arrowhead { fill: var(--sl-color-gray-4); }
  .node { cursor: pointer; outline: none; }
  .node rect { fill: var(--sl-color-black); stroke: var(--rondo-border); stroke-width: 1.5; transition: stroke 0.15s, fill 0.15s; }
  .node:is(:hover, :focus-visible) rect { stroke: var(--sl-color-accent); }
  .node.on rect { stroke: var(--sl-color-accent); stroke-width: 2.5; fill: var(--sl-color-accent-low); }
  .nl { fill: var(--sl-color-white); font-size: 13px; font-weight: 650; font-family: var(--sl-font-mono); }
  .ns { fill: var(--sl-color-gray-3); font-size: 10.5px; }
  .panel { margin-top: 1rem; padding: 0.9rem 1.1rem; border-radius: 0.6rem; background: var(--rondo-surface-2); border-left: 4px solid var(--sl-color-accent); min-height: 9rem; }
  .panel h4 { margin: 0; font-size: var(--sl-text-base); }
  .panel p { margin: 0.35rem 0 0.5rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
  .panel ul { margin: 0; padding-left: 1.1rem; font-size: var(--sl-text-xs); display: grid; gap: 0.2rem; }
  .panel li { margin: 0; }
  @keyframes flow { to { stroke-dashoffset: -16; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.archmap').forEach((root) => {
    const nodes = [...root.querySelectorAll<SVGGElement>('.node')];
    const cards = [...root.querySelectorAll<HTMLElement>('.panel article')];
    const select = (id: string) => {
      nodes.forEach((n) => n.classList.toggle('on', n.dataset.id === id));
      cards.forEach((c) => (c.hidden = c.dataset.for !== id));
    };
    nodes.forEach((n) => {
      n.addEventListener('click', () => select(n.dataset.id!));
      n.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          select(n.dataset.id!);
        }
      });
    });
    select(nodes[0].dataset.id!);
  });
</script>
