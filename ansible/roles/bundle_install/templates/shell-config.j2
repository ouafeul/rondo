# ==============================================================================
#  {{ rondo_component }}, configuration generated by RONDO. Do not edit by hand.
#
#  Source: Component.spec.vm.config (+ the config of group {{ rondo_group | default('?') }}).
#  Machine: {{ inventory_hostname }} ({{ ansible_host | default('?') }})
#  Any local change is overwritten at the next reconciliation.
# ==============================================================================
{% for key in rondo_config | sort %}
{% set item = rondo_config[key] %}
{% if item.kind == 'list' %}
{{ key }}=(
{% for v in item.value %}
  {{ v | to_json }}
{% endfor %}
)
{% elif item.kind == 'bool' %}
{{ key }}={{ 'true' if item.value else 'false' }}
{% elif item.kind == 'number' %}
{{ key }}={{ item.value }}
{% else %}
{{ key }}={{ item.value | string | to_json }}
{% endif %}
{% endfor %}
