#!/bin/sh
# The boot of an rondo-sandbox machine, what cloud-init does on a site's clone
# (terraform/vm/templates/cloud-init.yaml.tpl): the CA of the mirror trusted, the
# administration account with RONDO's key and sudo, /etc/rondo-release, and last the marker
# RONDO's playbook waits for. rondo-sandbox mounts what it needs under /etc/rondo-machine. Then
# systemd, as PID 1.
set -eu

# Docker mounts the container's own cgroup (private namespace) read-only; systemd writes it.
mount -o remount,rw /sys/fs/cgroup

seed=/etc/rondo-machine
user="${RONDO_MACHINE_USER:-rondo}"

if [ -f "${seed}/ca.pem" ]; then
    cp "${seed}/ca.pem" /etc/pki/ca-trust/source/anchors/mirror-ca.pem
    update-ca-trust extract
fi

id "${user}" >/dev/null 2>&1 || useradd -m -G wheel -s /bin/bash "${user}"
install -d -m 0700 -o "${user}" -g "${user}" "/home/${user}/.ssh"
install -m 0600 -o "${user}" -g "${user}" "${seed}/authorized_key" "/home/${user}/.ssh/authorized_keys"
printf '%s ALL=(ALL) NOPASSWD:ALL\n' "${user}" > "/etc/sudoers.d/${user}"
chmod 0440 "/etc/sudoers.d/${user}"

if [ -n "${RONDO_COMPONENT:-}" ]; then
    printf 'RONDO_COMPONENT=%s\nRONDO_GROUP=%s\nRONDO_HOSTNAME=%s\n' \
        "${RONDO_COMPONENT}" "${RONDO_GROUP:-}" "$(cat /proc/sys/kernel/hostname)" > /etc/rondo-release
fi

touch /var/lib/rondo-cloud-init-done
exec /sbin/init
