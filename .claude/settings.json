{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go run ./cmd/rondo component lint:*)",
      "Bash(gofmt:*)",
      "Bash(scripts/ci/gen-crds.sh:*)",
      "Bash(scripts/ci/envtest-version.sh)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 scripts/ci/check-coverage.py:*)",
      "Bash(ruff check:*)",
      "Bash(shellcheck:*)",
      "Bash(npm ci:*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push origin :*)",
      "Bash(git tag:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)",
      "Read(./**/*.tfstate)",
      "Read(./**/kubeconfig*)",
      "Read(./.env)",
      "Read(./**/*.env)"
    ]
  }
}
